# ---- دیتابیس داخلی (PostgreSQL داخل Docker Compose) ----
# در حالت Docker Compose، هاست دیتابیس نام سرویس postgres است.
DATABASE_URL="postgresql://okr:okr_password@localhost:5432/okr_tracker?schema=public"

# ---- NextAuth ----
# یک مقدار تصادفی قوی بگذارید: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-strong-random-secret"
# آدرس دسترسی به اپ (روی سرور داخلی، دامنه/IP داخلی خودتان)
NEXTAUTH_URL="http://localhost:3000"

# ---- متغیرهای دیتابیس برای سرویس postgres در docker-compose ----
POSTGRES_USER="okr"
POSTGRES_PASSWORD="okr_password"
POSTGRES_DB="okr_tracker"

# ---- پسورد اولیه کاربران seed (پس از اولین ورود باید تغییر داده شود) ----
SEED_DEFAULT_PASSWORD="okr405@TPD"

# ---- پورتی که اپ روی سیستم/سرور در دسترس است (اگر 3000 اشغال است عوضش کنید) ----
APP_PORT=3000
